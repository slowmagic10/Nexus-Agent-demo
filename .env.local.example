# 复制为 .env.local，并填写任意支持 Chat Completions 工具调用的 API。
# .env.local 已加入 .gitignore，不会被 Git 提交。

OPENAI_API_KEY=REPLACE_WITH_YOUR_API_KEY
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash

# 模型上下文窗口；请按 Provider 实际能力设置。它不会关闭工具历史精简或语义摘要。
NEXUS_CONTEXT_WINDOW_TOKENS=32000

# 可选：常用输入目标和输出预留；示例数值仅用于配置说明，默认不启用。
# 输出参数必须按实际服务选择 max_tokens 或 max_completion_tokens，不自动猜测。
# NEXUS_CONTEXT_TARGET_TOKENS=24000
# NEXUS_MAX_OUTPUT_TOKENS=8000
# NEXUS_OUTPUT_TOKEN_PARAMETER=max_tokens
# NEXUS_STREAM_USAGE=true
# 使用 provider-default 可重置前面三个可选字段；stream usage 使用 false 关闭。

# provider-default 不发送思考开关；DeepSeek 长工具任务可设 disabled 以降低推理成本。
NEXUS_PROVIDER_THINKING=disabled

# 正整数表示单次任务的步骤上限；unlimited 或 0 表示不限制。
NEXUS_MAX_STEPS=unlimited

# 可选：CLI/Gateway 的受管项目根目录；默认是 ~/Nexus Projects。
# NEXUS_PROJECTS_ROOT=/Users/你的用户名/Nexus Projects
