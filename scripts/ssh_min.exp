#!/usr/bin/expect -f
set timeout 12
set pwd $env(NEXUS_SSH_PWD)
spawn ssh -o StrictHostKeyChecking=accept-new -o ConnectTimeout=5 -o PreferredAuthentications=password -o PubkeyAuthentication=no -o ForwardX11=no 192.168.121.110 hostname
expect {
    -re "password:" { send "$pwd\r" }
    timeout { puts "NO_PASSWORD_PROMPT"; exit 1 }
}
expect eof
